TV_APP_NAME=TrafficVision
TV_DEBUG=false
TV_INPUT_DIR=data/input
TV_OUTPUT_DIR=data/output
TV_MAX_UPLOAD_SIZE_MB=500
TV_ALLOWED_EXTENSIONS=.mp4,.avi,.mov,.mkv

# Model (yolov8s.pt recommended for better motorcycle/bus/truck accuracy)
TV_MODEL_PATH=yolov8s.pt

# Performance tuning (CPU inference)
TV_IMGSZ=640
TV_FRAME_STRIDE=2
TV_INFERENCE_BACKEND=auto

# Motion ROI (only helps for sparse traffic / static cameras with large static areas)
TV_USE_MOG_ROI=false
TV_MOG_HISTORY=200
TV_MOG_VAR_THRESHOLD=16.0
TV_MOG_DETECT_SHADOWS=true
TV_ROI_PADDING=20
TV_MAX_ROI_AREA_RATIO=0.5

# Per-class confidence (lower = more detections for that class)
TV_CONF_CAR=0.25
TV_CONF_MOTORCYCLE=0.15
TV_CONF_BUS=0.20
TV_CONF_TRUCK=0.20